# Copy to morning-brief/.env. Both keys are optional. With no ANTHROPIC_API_KEY the script is
# written by the local Claude Code CLI (`claude`) if it is installed and signed in; with no Claude
# at all the brief reads out the top posts. Without ElevenLabs the page uses the browser's voice.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2
# BRIEF_AT=07:30            # make a brief automatically at this local time every day
# The default spoken length is 90 seconds; the page offers 45 to 90 seconds.
# BRIEF_HOURS=24            # default window, and how far back a new interest is replayed
# BRIEF_LANGS=en            # comma-separated post languages; empty for all
# BRIEF_MODEL=claude-opus-5
# BRIEF_LOCAL_MODEL=opus    # model for the local Claude Code CLI path
# BRIEF_EFFORT=             # low | medium | high | xhigh | max (default: low up to 3 minutes, medium above)
# BACKFILL_CONNECTIONS=12   # parallel replay connections; 8 hours takes roughly 8 minutes at 12
# RETAIN_HOURS=36
# PORT=5194
